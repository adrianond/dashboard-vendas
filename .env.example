DATABASE_PATH=./data/vendas.db

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_RAPIDO=claude-haiku-5-5
ANTHROPIC_MODEL_PRINCIPAL=claude-sonnet-5-5

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dashboard-vendas

# Agente (opcionais; padrões na seção 7.4 do PRD da Etapa 2)
DATA_REFERENCIA=2026-09-30
AGENT_MAX_TENTATIVAS=3
AGENT_TIMEOUT_MS=5000

# API (opcionais; seção 11 do PRD da Etapa 3)
AGENT_MODE=real                     # real | fake (fake proibido em produção)
TRUST_PROXY=false                   # true só atrás de um proxy confiável (usa o x-forwarded-for)
RATE_LIMIT_AGENTE_MINUTO=10
RATE_LIMIT_AGENTE_DIA=100
RATE_LIMIT_INDICADORES_MINUTO=120
RATE_LIMIT_FEEDBACK_MINUTO=30

# Testes com LLM real (custo): 1 para habilitar
RUN_LLM_TESTS=0
