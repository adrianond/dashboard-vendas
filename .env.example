DATABASE_PATH=./data/vendas.db

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_RAPIDO=claude-haiku-5-5
ANTHROPIC_MODEL_PRINCIPAL=claude-sonnet-5-5

# LangSmith
LANGSMITH_TRACING=true
